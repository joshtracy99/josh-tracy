# Public site URL, used in the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inbox that receives enquiries from the form on the homepage.
CONTACT_EMAIL=

# Resend (https://resend.com). Leave blank in development — submissions are logged instead.
RESEND_API_KEY=

# Drafts the free homepage preview. Leave blank in development — a plain draft is shown instead.
XAI_API_KEY=

# Must be an address on a domain verified in Resend.
# Until then, onboarding@resend.dev only delivers to the Resend account owner.
EMAIL_FROM=
